# Local: una sola URL. Supabase: DATABASE_URL = pooler (puerto 6543), DIRECT_URL = conexión directa/sesión (puerto 5432)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ds160_prep?schema=public"
DIRECT_URL=""
ENCRYPTION_KEY="base64-32-bytes"
AUTH_SECRET="random"
CLIENT_SESSION_SECRET="random"
IP_HASH_SECRET="random"
# Código de un solo uso para crear el primer Administrador en /admin/login (obligatorio en producción)
ADMIN_SETUP_TOKEN=""
NEXT_PUBLIC_DEFAULT_WHATSAPP=""
APP_TIMEZONE="America/Santo_Domingo"

# --- Almacenamiento de documentos (Supabase Storage, bucket privado) ---
# URL del proyecto: Settings > API > Project URL
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Clave service_role (Settings > API Keys). SOLO servidor: nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=""
# Secreto para la tarea programada de borrado de documentos (Vercel Cron)
CRON_SECRET="random"
